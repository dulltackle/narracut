{
  "name": "narracut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:plugin": "esbuild plugins/narracut/src/server.ts --bundle --platform=node --format=esm --outfile=plugins/narracut/server.mjs",
    "test:plugin": "pnpm build:plugin && bash scripts/test-plugin-stdio.sh",
    "prestart": "pnpm build",
    "start": "tsx src/server/cli.ts",
    "create": "tsx src/server/cli.ts create",
    "open": "tsx src/server/cli.ts open",
    "inspect": "tsx src/server/cli.ts inspect",
    "dry-run": "tsx src/server/cli.ts dry-run",
    "test": "pnpm test:schema && pnpm test:plugin && pnpm test:unit && pnpm test:e2e",
    "test:schema": "tsx docs/spec/verify-project-examples.ts",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:public": "playwright test --config playwright.public.config.ts",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "test:codex-host:real": "NARRACUT_REAL_CODEX_HOST=1 vitest run tests/narracut-codex-host.live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/cli": "4.0.512",
    "@remotion/media": "4.0.512",
    "@remotion/player": "4.0.512",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.512",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@remotion/bundler": "4.0.512",
    "@remotion/renderer": "4.0.512",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/serve-handler": "^6.1.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
