  "scenes": [
    {
      "id": "20000000-0000-4000-8000-000000000001",
      "narration": {
        "text": "取 100 毫升生理盐水，加入一支盐酸利多卡因注射液"
      },
      "visual": {
        "type": "image",
        "assetId": "10000000-0000-4000-8000-000000000001"
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000002",
      "narration": {
        "text": "从球囊连接管套装中取出连接管"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000002",
        "caption": {
          "text": "准备连接管",
          "textStyleId": "narracut/lower-third@1",
          "textMotionId": "narracut/rise@1"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000003",
      "narration": {
        "text": "将连接管与治疗仪副泵接通"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000003",
        "caption": {
          "text": "连接副泵"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000004",
      "narration": {
        "text": "将连接管与生理盐水瓶连接"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000004",
        "caption": {
          "text": "连接盐水瓶"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000005",
      "narration": {
        "text": "将双腔管的绿色接头暂时关闭"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000005",
        "caption": {
          "text": "暂时关闭绿色接头"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000006",
      "narration": {
        "text": "将白色接头与连接管对接"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000006",
        "caption": {
          "text": "对接白色接头"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000007",
      "narration": {
        "text": "点击“通液排气”，排尽管内空气"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000007",
        "caption": {
          "text": "确认管内空气已经排尽"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000008",
      "narration": {
        "text": "将双腔管缓慢置入宫腔内"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000008"
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000009",
      "narration": {
        "text": "使用 5 毫升注射器与双腔管的绿色接头连接"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000009",
        "caption": {
          "text": "连接注射器"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000010",
      "narration": {
        "text": "通过注射器向双腔管球囊内注气，实现锁宫"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000010",
        "caption": {
          "text": "球囊注气锁宫"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000011",
      "narration": {
        "text": "点击“通液治疗”，进行输卵管通液；治疗仪将根据子宫内压力情况，自动调整通液量"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000011",
        "caption": {
          "text": "开始通液治疗"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000012",
      "narration": {
        "text": "治疗完成后打开双腔管的绿色接头，解除锁宫"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000012",
        "caption": {
          "text": "治疗完成后解除锁宫"
        }
      },
      "transition": "cut"
    },
    {
      "id": "20000000-0000-4000-8000-000000000013",
      "narration": {
        "text": "将双腔管缓慢从宫腔内取出"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000013"
      },
      "transition": "cut"
    }
