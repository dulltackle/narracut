  "scenes": [
    {
      "id": "30000000-0000-4000-8000-000000000001",
      "narration": {
        "text": "本视频演示宫腔通液治疗仪的规范操作流程。"
      },
      "visual": {
        "type": "title",
        "device": "宫腔通液治疗仪",
        "headline": "宫腔通液规范操作",
        "subheadline": "连接、排气、治疗与退出"
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000002",
      "narration": {
        "text": "开始前，请确认生理盐水与盐酸利多卡因注射液准备齐全。"
      },
      "visual": {
        "type": "image",
        "assetId": "10000000-0000-4000-8000-000000000001"
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000003",
      "narration": {
        "text": "取 100 毫升生理盐水，加入一支盐酸利多卡因注射液。"
      },
      "visual": {
        "type": "image-caption",
        "assetId": "10000000-0000-4000-8000-000000000001",
        "caption": {
          "kind": "step",
          "number": "01",
          "name": "配置通液液体"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000004",
      "narration": {
        "text": "从球囊连接管套装中取出连接管。"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000002"
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000005",
      "narration": {
        "text": "将连接管与治疗仪副泵接通。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000003",
        "caption": {
          "kind": "step",
          "number": "02",
          "name": "连接治疗仪副泵"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000006",
      "narration": {
        "text": "再将连接管与生理盐水瓶连接。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000004",
        "caption": {
          "kind": "step",
          "number": "03",
          "name": "连接生理盐水瓶"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000007",
      "narration": {
        "text": "此时应将双腔管的绿色接头暂时关闭。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000005",
        "caption": {
          "kind": "alert",
          "text": "暂时关闭绿色接头"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000008",
      "narration": {
        "text": "将白色接头与连接管可靠对接。"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000006"
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000009",
      "narration": {
        "text": "点击通液排气，并确认管内空气已经排尽。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000007",
        "caption": {
          "kind": "alert",
          "text": "必须排尽管内空气"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000010",
      "narration": {
        "text": "排气完成后，将双腔管缓慢置入宫腔内。"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000008"
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000011",
      "narration": {
        "text": "使用 5 毫升注射器与双腔管的绿色接头连接。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000009",
        "caption": {
          "kind": "step",
          "number": "04",
          "name": "连接注射器"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000012",
      "narration": {
        "text": "通过注射器向球囊内注气，实现锁宫。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000010",
        "caption": {
          "kind": "step",
          "number": "05",
          "name": "球囊注气锁宫"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000013",
      "narration": {
        "text": "点击通液治疗，开始输卵管通液。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000011",
        "caption": {
          "kind": "step",
          "number": "06",
          "name": "开始通液治疗"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000014",
      "narration": {
        "text": "治疗仪会根据子宫内压力自动调整通液量，请持续观察。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000011",
        "caption": {
          "kind": "alert",
          "text": "持续观察压力变化"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000015",
      "narration": {
        "text": "治疗完成后，打开双腔管的绿色接头。"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000012"
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000016",
      "narration": {
        "text": "确认球囊已经泄气，锁宫状态已经解除。"
      },
      "visual": {
        "type": "image-caption",
        "assetId": "10000000-0000-4000-8000-000000000001",
        "caption": {
          "kind": "alert",
          "text": "确认球囊完全泄气"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000017",
      "narration": {
        "text": "随后将双腔管缓慢从宫腔内取出。"
      },
      "visual": {
        "type": "video",
        "assetId": "10000000-0000-4000-8000-000000000013"
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000018",
      "narration": {
        "text": "退出过程中保持动作缓慢，并留意患者反应。"
      },
      "visual": {
        "type": "video-caption",
        "assetId": "10000000-0000-4000-8000-000000000013",
        "caption": {
          "kind": "step",
          "number": "07",
          "name": "缓慢退出双腔管"
        }
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000019",
      "narration": {
        "text": "操作结束后，请再次核对连接部件和治疗记录。"
      },
      "visual": {
        "type": "image",
        "assetId": "10000000-0000-4000-8000-000000000001"
      },
      "transition": "cut"
    },
    {
      "id": "30000000-0000-4000-8000-000000000020",
      "narration": {
        "text": "请牢记规范连接、彻底排气和缓慢操作三个要点。"
      },
      "visual": {
        "type": "end-card",
        "title": "本节要点",
        "bullets": [
          "按顺序完成管路连接",
          "通液前彻底排尽空气",
          "置入与退出保持缓慢"
        ]
      },
      "transition": "cut"
    }
  ]
}
